---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StatsSummary from '../components/StatsSummary.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { fetchGitHubProjects, fetchGitHubProfile } from '../data/github';

// Build-Time Data Ingestion
const [{ projects, isFallback }, profile] = await Promise.all([
  fetchGitHubProjects(),
  fetchGitHubProfile(),
]);
---

<Layout
  title={`${profile.name || profile.login} // NEURAL_DEV_PORTFOLIO`}
  description={profile.bio || 'High-performance dynamic developer portfolio with cyberpunk anime.js motion.'}
>
  <Header profile={profile} isFallback={isFallback} />

  <main>
    <StatsSummary projects={projects} isFallback={isFallback} />

    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      {projects.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 px-4 border border-cyber-border bg-cyber-panel/60 cyber-clip-br">
          <svg
            class="w-12 h-12 text-cyber-cyan mx-auto mb-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
            />
          </svg>
          <h3 class="text-base font-tech font-bold text-cyber-yellow tracking-wider">[NO_PAYLOAD_DETECTED]</h3>
          <p class="text-xs font-mono text-cyber-muted mt-1 max-w-sm mx-auto">
            Zero public repositories returned by the neural query. Check connection or user permissions.
          </p>
        </div>
      )}
    </section>
  </main>

  <Footer />

  <!-- Cyberpunk Anime.js Client Hydration -->
  <script>
    import { initCyberpunkMotion } from '../scripts/cyberpunk-motion';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initCyberpunkMotion());
    } else {
      initCyberpunkMotion();
    }
  </script>
</Layout>
