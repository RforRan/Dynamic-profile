---
import '../styles/global.css';
import { portfolioConfig } from '../../portfolio.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${portfolioConfig.name} // ${portfolioConfig.title}`,
  description = portfolioConfig.bio,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;800&family=Orbitron:wght@600;800;900&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cyber-bg text-slate-100 flex flex-col min-h-screen relative antialiased cyber-grid-bg">
    <!-- Ambient CRT Scanline Overlay -->
    <div class="fixed inset-0 scanlines-overlay z-50 pointer-events-none opacity-30"></div>

    <!-- Top Neon HUD Cable Accent -->
    <div class="w-full h-1 bg-gradient-to-r from-cyber-cyan via-cyber-yellow to-cyber-pink shadow-neon-cyan z-40 fixed top-0 left-0"></div>

    <div class="flex-grow relative z-10">
      <slot />
    </div>
  </body>
</html>
