---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-800/80 bg-slate-950/80 py-10 text-xs font-mono text-slate-500">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>
        Generated with <strong class="text-slate-300 font-semibold">Astro SSG</strong> & <strong class="text-slate-300 font-semibold">GitHub Actions</strong>
      </span>
    </div>

    <div class="flex items-center gap-6 text-slate-400">
      <a
        href="https://github.com/RforRan/Dynamic-profile"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-200 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sky-400 rounded"
      >
        Source Code
      </a>
      <a
        href="https://github.com/RforRan"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-200 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sky-400 rounded"
      >
        GitHub Profile
      </a>
      <span>&copy; {currentYear} Randi (RforRan)</span>
    </div>
  </div>
</footer>
