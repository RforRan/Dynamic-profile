---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-cyber-border bg-cyber-asphalt/90 py-10 text-xs font-mono text-cyber-muted relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 bg-cyber-cyan shadow-neon-cyan"></span>
      <span>
        CORE: <strong class="text-cyber-cyan font-tech">ASTRO.SSG</strong> // AUTOMATION: <strong class="text-cyber-yellow font-tech">GITHUB_ACTIONS</strong>
      </span>
    </div>

    <div class="flex items-center gap-6 text-cyber-subtext">
      <a
        href="https://github.com/RforRan/Dynamic-profile"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-cyber-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyber-cyan"
      >
        [SOURCE_CODE]
      </a>
      <a
        href="https://github.com/RforRan"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-cyber-yellow transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyber-yellow"
      >
        [GITHUB_MAINFRAME]
      </a>
      <span class="text-cyber-muted">&copy; {currentYear} RANDI // RFORRAN</span>
    </div>
  </div>
</footer>
