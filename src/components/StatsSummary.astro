---
import type { PortfolioProject } from '../types/github';

interface Props {
  projects: PortfolioProject[];
  isFallback: boolean;
}

const { projects, isFallback } = Astro.props;

const totalStars = projects.reduce((acc, p) => acc + p.stars, 0);
const totalForks = projects.reduce((acc, p) => acc + p.forks, 0);

// Hitung bahasa pemrograman yang paling sering digunakan
const languageCounts = projects.reduce((acc, p) => {
  if (p.primaryLanguage && p.primaryLanguage !== 'Plain Text') {
    acc[p.primaryLanguage] = (acc[p.primaryLanguage] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

const topLanguages = Object.entries(languageCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
  {isFallback && (
    <div class="mb-6 p-4 rounded-xl bg-amber-950/40 border border-amber-800/60 text-amber-200 text-xs flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <strong class="font-semibold text-amber-300">Notice: Offline / Fallback Snapshot Active.</strong>
        <p class="mt-0.5 text-amber-200/90">
          The compilation process used local cached data due to GitHub API rate limit or network connectivity during build-time. The site remains fully functional and accessible.
        </p>
      </div>
    </div>
  )}

  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-slate-800/80">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-100">
        Open Source Repositories
      </h2>
      <p class="text-sm text-slate-400 mt-1.5 flex items-center gap-2">
        <span>Showing</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded font-mono font-semibold text-xs bg-slate-800 text-sky-400 border border-slate-700/60 tabular-nums">
          {projects.length}
        </span>
        <span>active repositories, sorted by stars & recent updates</span>
      </p>
    </div>

    <!-- Quick Metrics Counters -->
    <div class="flex items-center gap-4 text-xs font-mono">
      <div class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800/90 flex items-center gap-2">
        <span class="text-slate-400">Stars:</span>
        <span class="font-semibold text-amber-400 tabular-nums">{totalStars}</span>
      </div>
      <div class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800/90 flex items-center gap-2">
        <span class="text-slate-400">Forks:</span>
        <span class="font-semibold text-slate-200 tabular-nums">{totalForks}</span>
      </div>
      {topLanguages.length > 0 && (
        <div class="hidden lg:flex items-center gap-2 text-slate-400">
          <span>Stack:</span>
          <div class="flex items-center gap-1.5">
            {topLanguages.map(([lang]) => (
              <span class="px-2 py-1 rounded bg-slate-800/70 border border-slate-700/50 text-slate-300">
                {lang}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
