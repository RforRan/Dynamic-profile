---
import type { PortfolioProject } from '../types/github';

interface Props {
  projects: PortfolioProject[];
  isFallback: boolean;
}

const { projects, isFallback } = Astro.props;

const totalStars = projects.reduce((acc, p) => acc + p.stars, 0);
const totalForks = projects.reduce((acc, p) => acc + p.forks, 0);

// Hitung bahasa pemrograman yang paling sering digunakan
const languageCounts = projects.reduce((acc, p) => {
  if (p.primaryLanguage && p.primaryLanguage !== 'Plain Text') {
    acc[p.primaryLanguage] = (acc[p.primaryLanguage] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

const topLanguages = Object.entries(languageCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
  {isFallback && (
    <div class="mb-6 p-4 bg-cyber-pink/10 border-l-4 border-cyber-pink text-cyber-pink text-xs font-mono flex items-start gap-3 cyber-clip-sm">
      <span class="font-bold text-sm tracking-wider">[FAILSAFE_ACTIVATED]</span>
      <p class="text-cyber-pink/90">
        GitHub API rate-limit detected during compilation. System successfully engaged local immutable cache. Zero broken deployment.
      </p>
    </div>
  )}

  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-cyber-border">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-cyber-cyan tracking-widest uppercase mb-1">
        <span class="w-1.5 h-1.5 bg-cyber-cyan"></span>
        <span>INDEX // PUBLIC_REPOSITORIES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-tech font-extrabold tracking-wide text-slate-100 uppercase">
        Project Matrix
      </h2>
      <p class="text-xs font-mono text-cyber-subtext mt-1.5 flex items-center gap-2">
        <span>DETECTED</span>
        <span class="inline-flex items-center px-2 py-0.5 font-bold text-xs bg-cyber-panel text-cyber-cyan border border-cyber-cyan/40 cyber-clip-sm tabular-nums">
          <span class="cyber-counter" data-value={projects.length}>{projects.length}</span>
          <span class="ml-1 text-[10px] text-cyber-muted">UNITS</span>
        </span>
        <span>SORTED BY STAR_WEIGHT & COMMIT_CADENCE</span>
      </p>
    </div>

    <!-- HUD Telemetry Counters with Anime.js Animation Hooks -->
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
      <!-- Total Stars -->
      <div class="hud-telemetry-item px-4 py-2.5 bg-cyber-panel border border-cyber-border cyber-clip-sm flex items-center gap-2.5">
        <span class="text-cyber-muted text-[11px] uppercase tracking-wider">STAR_TOTAL:</span>
        <span class="font-tech font-bold text-cyber-yellow text-sm tabular-nums flex items-center gap-1">
          <svg class="w-3.5 h-3.5 fill-current text-cyber-yellow" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="cyber-counter" data-value={totalStars}>{totalStars}</span>
        </span>
      </div>

      <!-- Total Forks -->
      <div class="hud-telemetry-item px-4 py-2.5 bg-cyber-panel border border-cyber-border cyber-clip-sm flex items-center gap-2.5">
        <span class="text-cyber-muted text-[11px] uppercase tracking-wider">FORK_COUNT:</span>
        <span class="font-tech font-bold text-cyber-cyan text-sm tabular-nums flex items-center gap-1">
          <svg class="w-3.5 h-3.5 fill-current text-cyber-cyan" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
          </svg>
          <span class="cyber-counter" data-value={totalForks}>{totalForks}</span>
        </span>
      </div>

      <!-- Tech Stack Badges -->
      {topLanguages.length > 0 && (
        <div class="hud-telemetry-item hidden lg:flex items-center gap-1.5 pl-2">
          {topLanguages.map(([lang]) => (
            <span class="px-2 py-1 text-[11px] bg-cyber-asphalt border border-cyber-muted/40 text-cyber-subtext cyber-clip-sm">
              #{lang}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
