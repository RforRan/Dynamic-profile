---
import type { GitHubUserProfile } from '../types/github';

interface Props {
  profile: GitHubUserProfile;
  isFallback: boolean;
}

const { profile, isFallback } = Astro.props;
---

<header class="border-b border-cyber-border bg-cyber-asphalt/90 backdrop-blur-md sticky top-0 z-30">
  <!-- Decorative Technical Top Sub-line -->
  <div class="hidden sm:flex justify-between items-center px-4 sm:px-8 py-1 bg-cyber-bg/95 border-b border-cyber-muted/30 text-[10px] font-mono tracking-widest text-cyber-muted">
    <div class="flex items-center gap-4">
      <span class="text-cyber-cyan flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-cyber-cyan inline-block"></span>
        SYS.ONLINE
      </span>
      <span>NODE: AP-SOUTHEAST</span>
      <span>RUNTIME: ASTRO.SSG</span>
    </div>
    <div class="flex items-center gap-4">
      <span>LATENCY: 0.00 MS [BUILD-TIME]</span>
      <span class="text-cyber-yellow">SECURITY: ENFORCED</span>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      
      <!-- Profile Branding & Industrial Avatar HUD -->
      <div class="flex items-center gap-4 hud-header-element">
        <!-- Avatar Frame with Corner Brackets -->
        <a
          href={profile.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative shrink-0 p-1 bg-cyber-panel cyber-clip-sm border border-cyber-cyan/50 hover:border-cyber-cyan hover:shadow-neon-cyan transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyber-cyan"
          aria-label={`Open ${profile.login} GitHub profile`}
        >
          <img
            src={profile.avatar_url}
            alt={`${profile.name || profile.login} avatar`}
            width="56"
            height="56"
            class="w-12 h-12 sm:w-14 sm:h-14 cyber-clip-sm object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-200"
            loading="eager"
          />
          <span
            class="absolute -bottom-1 -right-1 w-3 h-3 bg-cyber-cyan border border-cyber-bg cyber-status-pulse"
            title="System Active"
          ></span>
        </a>

        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-tech font-extrabold tracking-wider text-slate-100 cyber-glitch-header">
              {profile.name || profile.login}
            </h1>
            <span class="text-[11px] font-mono text-cyber-yellow px-2 py-0.5 bg-cyber-yellow/10 border border-cyber-yellow/40 cyber-clip-sm font-semibold tracking-wider">
              //{profile.login}
            </span>
          </div>

          <p class="text-xs font-mono text-cyber-subtext mt-1 max-w-xl line-clamp-1 sm:line-clamp-none">
            <span class="text-cyber-cyan">&gt;</span> {profile.bio}
          </p>
        </div>
      </div>

      <!-- Live Telemetry Status & External Portal -->
      <div class="flex items-center gap-3 self-start sm:self-center hud-header-element">
        <!-- Telemetry Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono bg-cyber-panel border border-cyber-cyan/30 text-cyber-cyan cyber-clip-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full bg-cyber-cyan opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 bg-cyber-cyan"></span>
          </span>
          <span class="tracking-wider">{isFallback ? 'SNAPSHOT.CACHED' : 'BUILD_SYNC.ACTIVE'}</span>
        </div>

        <!-- Cyber Button -->
        <a
          href={profile.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex items-center gap-2 px-4 py-1.5 text-xs font-mono font-bold tracking-wider text-cyber-bg bg-cyber-yellow hover:bg-cyber-cyan hover:shadow-neon-cyan transition-all duration-150 cyber-clip-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyber-yellow"
          aria-label={`Visit GitHub profile of ${profile.login}`}
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>GITHUB.CONNECT</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Animated SVG Circuit Line below Header -->
  <svg class="w-full h-1 block" preserveAspectRatio="none" viewBox="0 0 1200 4">
    <path
      class="hud-path"
      d="M0 2 L400 2 L420 4 L800 4 L820 2 L1200 2"
      fill="none"
      stroke="#00F0FF"
      stroke-width="1.5"
      stroke-opacity="0.4"
    ></path>
  </svg>
</header>
