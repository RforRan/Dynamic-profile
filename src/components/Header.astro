---
import type { GitHubUserProfile } from '../types/github';

interface Props {
  profile: GitHubUserProfile;
  isFallback: boolean;
}

const { profile, isFallback } = Astro.props;
---

<header class="border-b border-slate-800/80 bg-slate-950/60 backdrop-blur-sm sticky top-0 z-30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <!-- Profile Branding -->
      <div class="flex items-center gap-4">
        <a
          href={profile.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative group shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded-full"
        >
          <img
            src={profile.avatar_url}
            alt={`${profile.name || profile.login} avatar`}
            width="56"
            height="56"
            class="w-14 h-14 rounded-full border-2 border-slate-700/80 object-cover group-hover:border-sky-400 transition-colors"
            loading="eager"
          />
          <span
            class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full border-2 border-slate-950 bg-emerald-500"
            title="Active on GitHub"
          ></span>
        </a>

        <div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-100 flex items-center gap-2">
            <span>{profile.name || profile.login}</span>
            <span class="text-xs font-mono font-medium text-slate-400 px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700/60">
              @{profile.login}
            </span>
          </h1>
          <p class="text-sm text-slate-400 mt-1 max-w-xl line-clamp-1 sm:line-clamp-none">
            {profile.bio}
          </p>
        </div>
      </div>

      <!-- Action & Live Telemetry Indicator -->
      <div class="flex items-center gap-3 self-start sm:self-center">
        <!-- Telemetry Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono bg-slate-900 border border-slate-800 text-slate-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>{isFallback ? 'Cached Snapshot' : 'Build-Time Synced'}</span>
        </div>

        <!-- GitHub Profile Action -->
        <a
          href={profile.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
          aria-label={`View ${profile.login} GitHub profile`}
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </div>
</header>
