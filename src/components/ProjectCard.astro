---
import type { PortfolioProject } from '../types/github';

interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
const hexId = (project.id % 0xfffff).toString(16).padStart(5, '0').toUpperCase();
---

<article
  class="cyber-card group relative flex flex-col justify-between bg-cyber-panel/90 border border-cyber-border hover:border-cyber-cyan p-5 transition-all duration-150 cyber-clip-br hover:shadow-neon-cyan"
>
  <!-- Ambient Hover Glow Layer -->
  <div class="cyber-card-glow absolute inset-0 bg-gradient-to-br from-cyber-cyan/10 via-transparent to-cyber-yellow/5 opacity-0 pointer-events-none transition-opacity duration-150"></div>

  <!-- Tech Wireframe Corner Reticle -->
  <div class="absolute top-2 right-2 flex items-center gap-1 text-[9px] font-mono text-cyber-muted select-none">
    <span class="text-cyber-cyan">+</span>
    <span>HEX_{hexId}</span>
  </div>

  <div>
    <!-- Card Header: Title & External Link -->
    <div class="flex items-start justify-between gap-3 pr-14">
      <h3 class="cyber-card-title text-base font-tech font-bold text-slate-100 group-hover:text-cyber-cyan transition-colors line-clamp-1">
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyber-cyan rounded-none"
          aria-label={`Open repository ${project.name} on GitHub`}
        >
          {project.name}
        </a>
      </h3>
    </div>

    <!-- Card Body: Description -->
    <p class="text-xs font-mono text-cyber-subtext mt-3 line-clamp-3 leading-relaxed">
      {project.description}
    </p>

    <!-- Topics/Tags -->
    {project.topics.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-3.5">
        {project.topics.slice(0, 3).map((topic) => (
          <span class="text-[10px] font-mono px-2 py-0.5 bg-cyber-asphalt text-cyber-cyan border border-cyber-cyan/30 cyber-clip-sm">
            #{topic}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Card Footer: Language & Telemetry -->
  <div class="relative z-10 flex items-center justify-between gap-4 mt-5 pt-3.5 border-t border-cyber-border/70 text-xs font-mono text-cyber-muted">
    <!-- Language Tag -->
    <div class="flex items-center gap-2 min-w-0">
      <span
        class="w-2 h-2 shrink-0 shadow-sm"
        style={`background-color: ${project.languageColor}; box-shadow: 0 0 6px ${project.languageColor}`}
        aria-hidden="true"
      ></span>
      <span class="truncate text-slate-300 font-semibold tracking-wide text-[11px]">
        {project.primaryLanguage}
      </span>
    </div>

    <!-- Engagement Stats (Stars & Forks) -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Stars -->
      <span class="inline-flex items-center gap-1 text-cyber-subtext group-hover:text-cyber-yellow transition-colors" title={`${project.stars} stars`}>
        <svg class="w-3.5 h-3.5 text-cyber-yellow fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="tabular-nums font-bold text-slate-200">{project.stars}</span>
      </span>

      <!-- Forks -->
      <span class="inline-flex items-center gap-1 text-cyber-subtext group-hover:text-cyber-cyan transition-colors" title={`${project.forks} forks`}>
        <svg class="w-3.5 h-3.5 text-cyber-cyan fill-current" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
        </svg>
        <span class="tabular-nums font-bold text-slate-200">{project.forks}</span>
      </span>

      <!-- External Link Icon -->
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-cyber-muted group-hover:text-cyber-yellow transition-colors p-1"
        aria-label={`Open repository ${project.name}`}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</article>
